{
  "name": "web",
  "version": "1.0.0",
  "description": "Nonlinear control theory and AI knowledge base",
  "main": "index.js",
  "scripts": {
    "prebuild": "",
    "start": "npm-run-all get-theme build:sass build:client --parallel watch:*",
    "watch:client": "node scripts/build-client.mjs --watch",
    "watch:sass": "sass --watch src/site/styles:dist/styles",
    "watch:eleventy": "cross-env ELEVENTY_ENV=dev eleventy --serve --incremental --port=8080",
    "build:client": "node scripts/build-client.mjs",
    "build:eleventy": "cross-env ELEVENTY_ENV=prod NODE_OPTIONS=--max-old-space-size=4096 eleventy",
    "build:sass": "sass src/site/styles:dist/styles --style compressed",
    "get-theme": "node src/site/get-theme.js",
    "clean": "rimraf dist",
    "build": "npm-run-all clean get-theme build:sass build:client build:eleventy",
    "verify:build": "node scripts/verify-build.mjs",
    "lint": "npm-run-all lint:*",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/site/styles/**/*.scss\"",
    "lint:scss:fix": "stylelint \"src/site/styles/**/*.scss\" --fix",
    "format": "prettier --write \"**/*.{js,json,md,yml,yaml,scss,css}\"",
    "format:check": "prettier --check \"**/*.{js,json,md,yml,yaml,scss,css}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{scss,css}": [
      "stylelint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "@xmldom/xmldom": "^0.9.12"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.5",
    "@11ty/eleventy-img": "^7.0.0",
    "@11ty/eleventy-plugin-rss": "^1.2.0",
    "@chenglou/pretext": "^0.0.8",
    "@eslint/js": "^10.0.1",
    "@sindresorhus/slugify": "^1.1.0",
    "axios": "^1.20.0",
    "cross-env": "^10.0.0",
    "dotenv": "^17.0.0",
    "eleventy-plugin-nesting-toc": "^1.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "fs-file-tree": "^1.1.1",
    "glob": "^11.0.0",
    "globals": "^17.3.0",
    "gray-matter": "^4.0.3",
    "html-minifier-terser": "^7.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "markdown-it": "^15.0.1",
    "markdown-it-anchor": "^9.0.1",
    "markdown-it-attrs": "^4.1.6",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-mathjax3": "^4.3.1",
    "markdown-it-plantuml": "^1.4.1",
    "markdown-it-task-checkbox": "^1.0.6",
    "node-html-parser": "^7.0.1",
    "npm-run-all2": "^8.0.4",
    "prettier": "^3.8.1",
    "rimraf": "^6.0.1",
    "sass": "^1.49.9",
    "sharp": "^0.35.4",
    "stylelint": "^17.4.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0"
  }
}
